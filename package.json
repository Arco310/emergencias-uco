{
  "name": "gestor-emergencias-uco",
  "version": "1.0.3",
  "description": "Gestor de Emergencias UCO: gestión de preventivos, unidades, avisos, descansos, planos y estadísticas. PWA offline-first con sincronización multidispositivo.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test --test-force-exit tests/unit/*.test.mjs tests/server/*.test.mjs",
    "test:e2e": "python3 tests/e2e/run_e2e.py",
    "server": "node server/server.mjs --static dist/app --data ./datos-servidor --port 8443"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}